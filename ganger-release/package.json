{
  "name": "desktop-keeping-reading-12a8c0",
  "productName": "Reading List",
  "version": "1.0.1",
  "description": "Reading List, made with Ganger.",
  "author": {
    "name": "Reading List"
  },
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.ganger.desktopkeepingreading12a8c0",
    "productName": "Reading List",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "package.json",
      "site/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
